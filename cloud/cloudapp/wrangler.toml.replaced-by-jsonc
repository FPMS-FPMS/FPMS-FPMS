# FPMS Cloud app — runs entirely on Cloudflare's free tier.
#
# No server, no broker, no AWS. Rovers POST telemetry over HTTPS (works from any
# cellular network), a Durable Object fans it out to viewers over WebSockets, and
# the existing built React frontend is served as static assets.
#
# Deploy:
#   npx wrangler secret put FPMS_PASSWORD       # viewer login
#   npx wrangler secret put FPMS_INGEST_TOKEN   # what rovers authenticate with
#   npx wrangler deploy

name = "fpms-cloud"
main = "src/worker.js"
compatibility_date = "2025-09-01"

workers_dev = true
# One public door only — the same reasoning as the gateway Worker.
preview_urls = false

# Serve the frontend the edge app already builds. Nothing is duplicated: this
# points straight at its dist output, so both apps ship the same UI.
[assets]
directory = "../dashboard/frontend/dist"
binding = "ASSETS"
# React Router owns client-side routes, so unknown paths return index.html.
not_found_handling = "single-page-application"

[[durable_objects.bindings]]
name = "HUB"
class_name = "TelemetryHub"

# Telemetry archive — the S3/DynamoDB equivalent. D1 rather than R2 because R2
# requires enabling billing on the dashboard, and D1's free tier needs nothing.
# 5 GB storage and 100k writes/day: two rovers at a 5s interval use ~35k/day.
[[d1_databases]]
binding = "DB"
database_name = "fpms-history"
database_id = "2c8afd6a-3074-4856-b971-6aef926508a3"

# Free-plan Durable Objects must use the SQLite storage backend.
[[migrations]]
tag = "v1"
new_sqlite_classes = ["TelemetryHub"]
