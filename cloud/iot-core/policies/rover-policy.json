{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConnectAsSelf",
      "Effect": "Allow",
      "Action": ["iot:Connect"],
      "Resource": ["arn:aws:iot:us-east-1:000000000000:client/${iot:Connection.Thing.ThingName}"]
    },
    {
      "Sid": "PublishOwnTelemetryAndEvents",
      "Effect": "Allow",
      "Action": ["iot:Publish"],
      "Resource": [
        "arn:aws:iot:us-east-1:000000000000:topic/fpms/${iot:Connection.Thing.ThingName}/events/*",
        "arn:aws:iot:us-east-1:000000000000:topic/fpms/${iot:Connection.Thing.ThingName}/telemetry/*"
      ]
    },
    {
      "Sid": "ReceiveOwnCommands",
      "Effect": "Allow",
      "Action": ["iot:Subscribe", "iot:Receive"],
      "Resource": [
        "arn:aws:iot:us-east-1:000000000000:topicfilter/fpms/${iot:Connection.Thing.ThingName}/commands/*",
        "arn:aws:iot:us-east-1:000000000000:topic/fpms/${iot:Connection.Thing.ThingName}/commands/*"
      ]
    }
  ]
}
