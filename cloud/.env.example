# Copy to .env and source before running awslocal / aws commands on your host.
#
#   cp cloud/.env.example cloud/.env
#   set -a; source cloud/.env; set +a
#
# LocalStack ignores the actual credential values — only their presence
# matters. Keep them literally "test" so no one confuses them with real keys.

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

# Turn up LocalStack verbosity while debugging (0/1)
LOCALSTACK_DEBUG=0
LOCALSTACK_LOG=warn

# IoT rule bridge log level (DEBUG/INFO/WARNING/ERROR)
BRIDGE_LOG=INFO
