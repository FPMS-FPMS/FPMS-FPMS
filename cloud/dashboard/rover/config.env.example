# FPMS rover configuration — TEMPLATE.
#
# The live file is /etc/fpms/config.env on the Pi and is read by the systemd
# units in units/ via EnvironmentFile. It is NOT in this repo and must never be:
# it holds the broker password. Copy this file, fill in the redacted values, and
# install it as /etc/fpms/config.env (root-owned, mode 0640).
#
# Captured from rover2 on 2026-08-04. Values below are the ones actually running
# except where marked <REDACTED>.

FPMS_THING_NAME=rover2

# --- broker -----------------------------------------------------------------
# The rover publishes to its OWN mosquitto on 127.0.0.1; that broker bridges
# everything to the laptop at 192.168.137.1:1883. The bridge is QoS 0, so on a
# saturated link messages are DROPPED, not queued — which is why the dashboard
# shows telemetry age rather than trusting the last value it received.
FPMS_MQTT_HOST=127.0.0.1
FPMS_MQTT_PORT=1883
FPMS_MQTT_USER=fpms
FPMS_MQTT_PASS=<REDACTED — set this to the mosquitto password>

# --- camera -----------------------------------------------------------------
# 6 fps at quality 40 is DELIBERATE. At the previous settings the camera stream
# saturated the WiFi link and starved the LiDAR feed. Do not raise these without
# re-measuring the LiDAR rate that reaches the dashboard.
FPMS_CAMERA_INDEX=0
FPMS_CAMERA_FPS=6
FPMS_JPEG_QUALITY=40

# --- lidar ------------------------------------------------------------------
FPMS_LIDAR_PORT=/dev/ttyUSB0
FPMS_LIDAR_BAUD=230400
FPMS_LIDAR_HZ=10

# --- perception -------------------------------------------------------------
FPMS_YOLO_DIR=/home/ubuntu/yolo
FPMS_OBSTACLE_ALERT_MM=400
FPMS_FIRE_MIN_RATIO=0.025
FPMS_FIRE_MIN_AREA=2500
FPMS_INFER_EVERY=2

# --- 2026-08-02: SLOW + SAFE after a full-speed 300mm burst hit an obstacle ---
# Amplitude does nothing on this firmware (~50% duty on any non-zero setpoint),
# so the ONLY lever for slowness is TIME. Short bursts, long settles.
FPMS_MISSION_MAX_LEG_MM=70
FPMS_MISSION_DOCK_STEP_MM=70
FPMS_MISSION_HOLD_S=1.5
# The LiDAR sits BEHIND the nose, so this distance is scanner-to-obstacle, not
# bumper-to-obstacle. 120 was a never-fires backstop; the operator's own prior
# working code stopped at 310-410mm raw. 400 restores that margin.
FPMS_MISSION_FRONT_STOP_MM=400
FPMS_MISSION_TURN_WIRE_SIGN=1
FPMS_MISSION_MIN_PULSE_S=0.35
FPMS_MISSION_CRUISE_MPS=0.18
