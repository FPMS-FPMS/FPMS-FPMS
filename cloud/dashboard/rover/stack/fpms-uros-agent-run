#!/bin/bash
# Launch the micro-ROS agent with the ESP32-S3 reset-release holder alongside it.
#
# The holder must run *concurrently* with the agent, not before or after it:
# - before, and its open would be the 0->1 open, so the agent's later open
#   re-asserts RTS and re-arms the reset;
# - after (as a one-shot ExecStartPost), and the lines snap back to 0x06 the
#   instant its fd closes, dropping the board straight back into reset. That was
#   measured on this rover, and it is why this is a wrapper rather than an
#   ExecStartPost.
# The holder polls until the agent owns the fd, then opens a second descriptor,
# clears RTS/DTR, and holds it for the lifetime of the agent.
#
# It lives in the unit's cgroup, so systemd's default KillMode=control-group
# reaps it with the agent and a restart re-runs the whole sequence.
set -e
DEV=/dev/serial/by-path/platform-fc880000.usb-usb-0:1.3:1.0-port0

source /opt/ros/humble/setup.bash
source /home/ubuntu/uros_ws/install/setup.bash

/usr/bin/python3 /usr/local/bin/fpms-uros-release-reset "$DEV" 30 &

# -b 230400 for FPMS firmware v3. This MUST match `#define BAUDRATE` in
# firmware_v3/fpms_config.h (230400) -- a mismatch shows up as an agent that
# runs happily and never establishes a session, which is indistinguishable
# from a dead board.
#
# It was 921600 until 2026-08-06, which was correct for the Yahboom FACTORY
# firmware v2.0.0 (that image prints "ros serial baudrate: 921600" from its own
# flash config). If you ever roll back to the factory image
# (/home/ubuntu/microROS_Robot_V2.0.0.bin) you MUST put 921600 back here.
#
# v3 dropped to 230400 deliberately: 921600 was measured unstable on this
# board -- the session died within 1-3 minutes, never established on cold
# boot, and degraded further under motor load.
exec ros2 run micro_ros_agent micro_ros_agent serial --dev "$DEV" -b 230400
