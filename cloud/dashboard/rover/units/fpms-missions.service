[Unit]
Description=FPMS mission executor (MQTT mission -> zone, dock, retrace home)
# Deliberately NO Requires=/BindsTo=/PartOf=/After= on micro-ros-agent,
# fpms-rover-agent or fpms-teleop. The micro-ROS serial link costs 90-225s to
# re-establish, so a dependency edge here would let a trivial mission tweak take
# every topic on the robot down with it. The reverse coupling is avoided too: if
# micro-ROS is down there is simply no odometry, and this node refuses to start
# a mission and aborts a running one within ROS_DEAD_S. A refusal that names the
# missing link is a cleaner failure than systemd shuffling units around.
#
# network-online is the only thing worth waiting for (DDS discovery + broker).
# mosquitto is now an explicit dependency. It was missing from every unit in
# this stack, and on a cold boot that is a real race: the broker takes a moment
# to bind :1883, and a client that tried first sat in its own retry loop while
# the dashboard showed nothing. paho's reconnect covers it eventually, but
# "eventually" at a competition is a service that looks broken for 30 seconds.
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

# ---- THE TWO TELEOP CONFLICTS: BOTH NOW FIXED IN CODE ----------------------
# This unit used to carry a "do not enable until..." warning about fpms-teleop.
# Both halves of it have since been fixed in fpms_teleop.py and the warning was
# stale, so it has been removed rather than left to be re-obeyed by someone who
# would then needlessly stop teleop before every run:
#   1. teleop's `_cmd_mission` now returns silently while this node is
#      publishing telemetry (`if self.bus.mission_active(): return`), so the
#      two no longer race to answer the same verb.
#   2. teleop's 2 Hz idle zero-Twist heartbeat is suppressed while a mission is
#      live, so it can no longer interleave zeros into this node's 20 Hz
#      setpoint.
# The app-level interlock remains as the real guard: this node runs a
# foreign-writer detector on /cmd_vel and NACKs a mission if anything else is
# writing. Trust that, not the boot order.
#
# ORDERED AFTER fpms-cored so the STOP authority is listening before anything
# that can move exists. Wants=, not Requires=: if cored is down this node must
# still start, because it has its own stop handling and a rover you cannot
# drive is not safer than one you can stop.
After=fpms-cored.service
Wants=fpms-cored.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
# MANDATORY. The board publishes on domain 20 and nowhere else; on any other
# domain this node sees no topics, and every mission refuses with "link down".
EnvironmentFile=-/etc/fpms/config.env
Environment=ROS_DOMAIN_ID=20
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/ubuntu
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && exec python3 /home/ubuntu/fpms_missions.py'
# SIGTERM lands on the python process, which aborts any running mission, then
# publishes zero Twist x10 before exiting. The generous stop timeout exists so
# that shutdown is never cut short by systemd killing us mid-stop — a service
# killed between "cut the drive" and "command zero" leaves a rover still moving.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=15
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
