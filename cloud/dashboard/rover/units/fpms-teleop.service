[Unit]
Description=FPMS teleop bridge (MQTT -> /cmd_vel)
# Deliberately NO Requires=/BindsTo=/PartOf= on micro-ros-agent or
# fpms-rover-agent. Those two are long-lived and expensive to restart (the
# micro-ROS link costs 90-225s to re-establish); a dependency here would let a
# teleop restart take them down with it. network-online is the only wait.
# mosquitto is now an explicit dependency. It was missing from every unit in
# this stack, and on a cold boot that is a real race: the broker takes a moment
# to bind :1883, and a client that tried first sat in its own retry loop while
# the dashboard showed nothing. paho's reconnect covers it eventually, but
# "eventually" at a competition is a service that looks broken for 30 seconds.
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
EnvironmentFile=-/etc/fpms/config.env
Environment=ROS_DOMAIN_ID=20
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/ubuntu
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && exec python3 /home/ubuntu/fpms_teleop.py'
# SIGTERM lands on the python process, which publishes zero Twist x10 before
# exiting. The generous stop timeout exists so that shutdown is never cut short
# by systemd killing us mid-stop.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=15
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
