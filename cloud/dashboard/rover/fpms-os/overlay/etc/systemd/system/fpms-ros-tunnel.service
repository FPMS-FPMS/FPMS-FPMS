[Unit]
Description=FPMS ROS tunnel (MASKED - second /cmd_vel writer)
Documentation=file:/home/ubuntu/STACK.md

# ###########################################################################
# # THIS UNIT IS MASKED. IT IS SHIPPED SO THAT IT CAN BE MASKED.            #
# ###########################################################################
#
# It is present in the image, and the build masks it, precisely BECAUSE
# masking a unit that does not exist is not the same thing as masking one that
# does. If this file were simply absent, a future `apt install`, a restored
# backup, or somebody copying it back from the old Pi would put an unmasked
# second /cmd_vel writer onto the robot.
#
# WHY IT MUST NOT RUN
# ===================
# It can write /cmd_vel. So can fpms-teleop and fpms-missions. Two writers on
# /cmd_vel is not a race the mission executor can win, or even reliably detect
# in time -- the executor subscribes to its own output to notice a foreign
# writer and NACK, but that is an app-level guard reacting after a command has
# already reached the wheels.
#
# MASKED, NOT DISABLED. `disable` only removes the WantedBy symlink; anything
# that pulls the unit in by name still starts it. Masking points the unit at
# /dev/null so it cannot be started by any path at all.
#
# To verify it is still masked:
#     systemctl is-enabled fpms-ros-tunnel.service     # -> masked
#
# fpms-selftest checks this every boot, because "disabled" and "masked" look
# similar in a hurry and only one of them is a guarantee.
#
# FPMS_TUNNEL_ALLOW_CMDVEL=0 below is a second, independent gate: with it at 0
# the Twist publisher is never even created. Belt and braces.

After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu

EnvironmentFile=-/etc/fpms/config.env
Environment=ROS_DOMAIN_ID=20
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=/etc/fpms/fastdds_udp_only.xml
Environment=ROS_LOCALHOST_ONLY=1
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/ubuntu
Environment=FPMS_TUNNEL_ALLOW_CMDVEL=0

ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && exec python3 /home/ubuntu/fpms_ros_tunnel.py'

KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=15
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
