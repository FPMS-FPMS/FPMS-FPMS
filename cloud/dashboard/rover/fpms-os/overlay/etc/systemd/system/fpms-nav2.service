[Unit]
Description=FPMS Nav2 stack (NOT ENABLED - preconditions unmet, see header)
Documentation=file:/home/ubuntu/nav2/NAV2_PLAN.md

# ###########################################################################
# # INSTALLED, NOT ENABLED. `systemctl start` ONLY, AND ONLY DELIBERATELY.  #
# ###########################################################################
#
# Everything Nav2 needs is preinstalled and tuned in this image. It is not in
# the boot path because three preconditions are unmet, and each of them makes
# Nav2 CONFIDENTLY WRONG rather than obviously broken:
#
#   1. THE LiDAR MOUNT TRANSFORM IS UNMEASURED. Every offset in
#      fpms_tf.launch.py is a MEASURE ME placeholder. 1 degree of mount yaw is
#      about 10.5 mm of position error, and both the obstacle cone guard and
#      the occupancy grid inherit it in the same direction, so it accumulates
#      rather than averaging out. The ExecStartPre below refuses to start until
#      FPMS_TF_OFFSETS_MEASURED=1.
#
#   2. LIDAR_ROTATION_SIGN IS UNVERIFIED. If the scan is mirrored, no value of
#      laser_yaw can undo it -- a mirror is not a rigid transform. Verify this
#      BEFORE measuring the mount offsets, or you will measure them against a
#      mirrored world.
#
#   3. map->odom OWNERSHIP. This unit does not itself publish map->odom, but if
#      you start it in SLAM mode, slam_toolbox does -- and fpms-map-anchor is
#      publishing a static one. TF_TREE.md: "One publisher per edge, no
#      exceptions." The SLAM units declare Conflicts= on the anchor so that is
#      mechanically enforced; this unit inherits whichever is running.
#
# ALSO NOTE
# =========
# fpms_nav2.launch.py's cmd_vel defaults to /cmd_vel_nav, a DELIBERATELY DEAD
# topic. If you launch this, leave that default alone until you have watched it
# plan for a while. It always starts controller_server and bt_navigator, and
# those drive wheels.
#
# The BT XML is patched: stock Nav2's BackUp recovery uses backup_speed=0.025
# m/s, under a fifth of this rover's firmware velocity floor, and NO PARAMETER
# CAN OVERRIDE IT because the speed lives in the XML. Every BackUp recovery
# with the stock file is a guaranteed stall-then-lurch.
#
# HOW TO ACTUALLY USE IT
# ======================
#   1. verify LIDAR_ROTATION_SIGN (is the scan mirrored?)
#   2. put a ruler on the LiDAR mount, write the numbers into
#      /etc/fpms/config.env, set FPMS_TF_OFFSETS_MEASURED=1
#   3. systemctl restart fpms-tf
#   4. ros2 run tf2_tools view_frames   -- confirm one publisher per edge
#   5. systemctl start fpms-nav2
#   6. watch it plan before you let it drive

After=fpms-ros-publishers.target fpms-tf.service fpms-lidar-ros.service
Wants=fpms-ros-publishers.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu

EnvironmentFile=-/etc/fpms/config.env
Environment=ROS_DOMAIN_ID=20
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=/etc/fpms/fastdds_udp_only.xml
Environment=ROS_LOCALHOST_ONLY=1
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/ubuntu

# Refuse to navigate on an unmeasured mount transform. A unit that fails
# loudly beats one that quietly plans against a 10 mm/degree error.
ExecStartPre=/bin/bash -c '[ "${FPMS_TF_OFFSETS_MEASURED:-0}" = "1" ] || { echo "REFUSING: FPMS_TF_OFFSETS_MEASURED is not 1 in /etc/fpms/config.env."; echo "The LiDAR mount transform has never been measured. See this unit header."; exit 1; }'

ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && exec ros2 launch /home/ubuntu/nav2/fpms_nav2.launch.py params_file:=/etc/fpms/nav2/nav2_params.yaml localization_mode:=${FPMS_NAV2_LOCALIZATION_MODE:-none}'

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal

# NO [Install] SECTION. This unit is deliberately not enableable by
# `systemctl enable` without an explicit --force, so it cannot drift into the
# boot path by accident.
