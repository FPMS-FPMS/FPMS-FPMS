# /etc/udev/rules.d/99-fpms-serial.rules
#
# Stable names for the rover's two CP2102 serial adapters and its camera.
#
# THE PROBLEM THIS SOLVES
# =======================
# Both onboard CP2102 USB-serial adapters report an IDENTICAL ID_SERIAL of
# "0001". udev can therefore only ever create ONE /dev/serial/by-id link for
# the pair, and it is a coin flip which device gets it. by-id is unusable here.
#
# /dev/ttyUSBn is worse: it is assigned in enumeration order, which is not
# guaranteed across boots. The old Pi renumbered these more than once.
#
# Getting it wrong is not a minor inconvenience. The two devices are the motor
# drive board and the LiDAR. Binding wrong sends motor command frames into the
# laser scanner, or opens the drive board's tty believing it is a scanner -
# and opening the drive tty raises the handshake lines wired to the ESP32-S3's
# EN/IO0 pins, RESETTING THE BOARD and costing a 90-225 second re-link that
# takes the rover's only pose source down with it.
#
# The USB TOPOLOGY PATH is the only discriminator. These rules therefore key on
# KERNELS== (the physical port), never on ATTRS{serial} - which matches both
# devices and is not a discriminator at all.
#
#   USB port 1.3  ->  ESP32-S3 micro-ROS drive board
#   USB port 1.2  ->  LiDAR (LD06/LD19 family)
#
# There is a recorded conflict about this assignment: golden_backup/phase6_latest.py
# says drive=1.2 / lidar=1.3, the opposite of everything current. The later
# sources agree with each other and one of them is the unit demonstrably driving
# the board today, so 1.3 = drive wins. DO NOT resolve this by trying both - the
# wrong one puts motor frames into the LiDAR. fpms-firstboot verifies the
# topology and refuses to guess if it does not match.
#
# ############################################################################
# # !! VERIFY ON HARDWARE AT FIRST BOOT !!                                   #
# #                                                                          #
# # The KERNELS== values below encode a USB bus number that has NOT been      #
# # confirmed on the new Orange Pi 5B. The by-path strings the services use   #
# # are known good (platform-fc880000.usb-usb-0:1.3:1.0-port0), but the       #
# # kernel device name that corresponds to them depends on the enumerated bus #
# # index. Confirm with:                                                      #
# #                                                                          #
# #     udevadm info -a -n /dev/ttyUSB0 | grep -m2 KERNELS                    #
# #     udevadm info -q path -n /dev/ttyUSB0                                  #
# #     ls -l /dev/serial/by-path/                                            #
# #                                                                          #
# # then correct the two KERNELS== patterns below if the bus is not 1.        #
# # fpms-selftest reports a FAIL if the symlinks did not materialise, so this #
# # cannot fail silently - but it is a five minute job to get right up front. #
# ############################################################################
#
# NOTE ON SCOPE: these symlinks are ADDITIVE CONVENIENCE. They are not a
# replacement for the by-path strings. Every service file, and
# fpms_duty_driver.validate_port(), already hardcode /dev/serial/by-path/...
# and that remains the canonical path. validate_port() actively REFUSES any
# path that is not under /dev/serial/by-path/, including by-id, for the reason
# above. Do not "simplify" the units to use these symlinks.

# --- ESP32-S3 micro-ROS drive board, USB port 1.3 ---------------------------
#
# ID_MM_DEVICE_IGNORE / ID_MM_PORT_IGNORE keep ModemManager away. This is not
# hygiene, it is safety-critical: ModemManager probes unknown serial devices by
# toggling handshake lines, and on this board RTS drives the ESP32-S3's EN pin.
# A probe is therefore a hardware reset of the drive board, mid-mission.
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", KERNELS=="1-1.3:1.0", \
  ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", \
  SYMLINK+="fpms-drive", GROUP="dialout", MODE="0660", \
  ENV{ID_MM_DEVICE_IGNORE}="1", ENV{ID_MM_PORT_IGNORE}="1"

# --- LiDAR, USB port 1.2 ----------------------------------------------------
#
# Same ModemManager exclusion. A probe here does not reset anything, but it
# does steal bytes from the scanner's frame stream, and the agent's failure
# mode for that is "frame starvation" - bytes arriving that are not LD frames -
# which does not raise and had to be given its own deadline to detect.
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", KERNELS=="1-1.2:1.0", \
  ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", \
  SYMLINK+="fpms-lidar", GROUP="dialout", MODE="0660", \
  ENV{ID_MM_DEVICE_IGNORE}="1", ENV{ID_MM_PORT_IGNORE}="1"

# --- Camera -----------------------------------------------------------------
#
# The camera is bound by index today (FPMS_CAMERA_INDEX=0) and that has already
# failed in the field: after a USB re-enumeration (error -71) the kernel handed
# it a different node and /dev/video0 became /dev/video1 mid-run. Several nodes
# also exist on the same device that are METADATA ONLY - they open fine, report
# isOpened(), and never produce a frame, which is why fpms_rover_agent's
# find_camera() requires an actual successful read() with a non-empty frame
# rather than trusting isOpened().
#
# ATTR{index}=="0" selects the capture node rather than the metadata nodes.
SUBSYSTEM=="video4linux", SUBSYSTEMS=="usb", ATTR{index}=="0", \
  SYMLINK+="fpms-cam", GROUP="video", MODE="0660"
