# /etc/fpms/config.env   (mode 0640, root:root)
#
# The single configuration point for the whole FPMS rover stack. Every service
# reads its broker host, credentials and calibration overrides from HERE, and
# for most of them NOT from the process environment.
#
# WHY THIS FILE MUST EXIST
# ========================
# Every service's load_config() swallows FileNotFoundError. If this file is
# missing, nothing crashes and nothing logs an error - instead every service
# falls back to defaults pointing at a broker at 192.168.137.1 with empty
# credentials, and retries forever. The dashboard is simply empty, with no
# fault anywhere. deploy_stack.sh hard-refuses to run without this file for
# exactly that reason. FPMS-OS ships it so the failure cannot happen.
#
# A TRAP WORTH KNOWING
# ====================
# The services disagree about whether the environment can override this file:
#   - fpms_cored.py and fpms_charact.py overlay os.environ ON TOP (env wins)
#   - fpms_lidar_ros.py overlays only the five MQTT keys
#   - fpms_rover_agent.py, fpms_missions.py, fpms_teleop.py read the FILE ONLY
# So an FPMS_MISSION_* value set as a systemd Environment= is IGNORED by the
# mission executor. Mission tuning must live in this file.
#
# NUMBER STATUS
# =============
# Every non-obvious value below carries its provenance. This project has been
# burned repeatedly by numbers that looked authoritative and were assumptions.
#   MEASURED   - somebody put an instrument on it, and when
#   ASSUMED    - a plausible default nobody has checked
#   UNMEASURED - explicitly not known; do not infer one from a nearby value
#   DISPUTED   - sources in this repo disagree; see the note
# Do not upgrade a status without doing the measurement.

# ============================================================================
# IDENTITY AND BROKER
# ============================================================================

FPMS_THING_NAME=rover2

# The local broker. Rover services talk to mosquitto on this box; mosquitto
# bridges to the operator laptop. That indirection is deliberate: an earlier
# setup pointed the services straight at the laptop and put a WiFi round trip
# on the Nav2-critical path, which dropped the LiDAR from ~9.8 Hz to 2.37 Hz.
FPMS_MQTT_HOST=127.0.0.1
FPMS_MQTT_PORT=1883
FPMS_MQTT_USER=fpms

# PLACEHOLDER. fpms-firstboot generates a random password on first boot, writes
# it here and into /etc/mosquitto/fpms.passwd, and prints it once so it can be
# entered on the laptop. FPMS-OS never ships a real or default password.
# fpms-selftest FAILS if this string is still present.
FPMS_MQTT_PASS=__FPMS_FIRSTBOOT_WILL_REPLACE_THIS__

# ============================================================================
# SERIAL DEVICES
# ============================================================================
#
# BY-PATH ONLY. Never /dev/ttyUSBn (enumeration order is not guaranteed) and
# never /dev/serial/by-id (both CP2102s report ID_SERIAL "0001", so by-id
# cannot tell them apart). Binding wrong sends motor frames into the LiDAR.
#
# NOTE: config.env.example in the repo still ships FPMS_LIDAR_PORT=/dev/ttyUSB0.
# That is the dangerous value and it is corrected here. The agent survives it
# today only because _resolve_lidar_port() overrides it at runtime.

FPMS_LIDAR_PORT=/dev/serial/by-path/platform-fc880000.usb-usb-0:1.2:1.0-port0
FPMS_LIDAR_BAUD=230400
FPMS_LIDAR_HZ=10

FPMS_DRIVE_PORT=/dev/serial/by-path/platform-fc880000.usb-usb-0:1.3:1.0-port0

# micro-ROS agent baud. ONE variable, because the unit file and the wrapper
# script previously disagreed (the unit's comment insisted on 921600 while the
# wrapper it invoked used 230400).
#   921600 - Yahboom FACTORY firmware v2.0.0. Its flash config prints
#            "ros serial baudrate: 921600" at boot.
#   230400 - FPMS firmware v3. MEASURED 2026-08-06: 921600 was unstable on this
#            board - the session died within 1-3 minutes, never established on
#            a cold boot, and degraded further under motor load.
# A mismatch here looks exactly like a dead board: the agent runs happily and
# never establishes a session.
FPMS_UROS_BAUD=230400

# ============================================================================
# CAMERA
# ============================================================================
#
# 6 fps at quality 40 is DELIBERATE, not a placeholder. At higher settings the
# camera stream saturated the WiFi link and starved the LiDAR feed. Do not
# raise these without re-measuring the LiDAR rate that actually reaches the
# dashboard. The sensor caps at 30 fps in hardware at every resolution anyway -
# that is its USB descriptor, not a software limit.
FPMS_CAMERA_INDEX=0
FPMS_CAMERA_FPS=6
FPMS_JPEG_QUALITY=40
FPMS_INFER_EVERY=2
FPMS_FIRE_EVERY=2

# ============================================================================
# NPU / DETECTION
# ============================================================================
#
# MUST be set explicitly. The code default is "v8", which imports
# fpms_yolo_npu.py from FPMS_YOLO_DIR - a file that exists ONLY on the old Pi
# and is in no repository. Left at the default, the agent silently runs without
# detection while systemd reports it active.
FPMS_YOLO_VARIANT=v26
FPMS_YOLO_DIR=/home/ubuntu/yolo

FPMS_FIRE_MIN_RATIO=0.025
FPMS_FIRE_MIN_AREA=2500
FPMS_FIRE_ON_FRAMES=5
FPMS_FIRE_OFF_FRAMES=45
FPMS_FIRE_REPEAT_S=120
FPMS_OBSTACLE_ALERT_MM=400
FPMS_OBSTACLE_REPEAT_S=300

# ============================================================================
# MISSION EXECUTOR
# ============================================================================

FPMS_MISSION_CRUISE_MPS=0.18
FPMS_MISSION_MAX_LEG_MM=70
FPMS_MISSION_DOCK_STEP_MM=70
FPMS_MISSION_HOLD_S=1.5

# Scanner-to-obstacle, NOT bumper-to-obstacle. The LiDAR sits behind the nose.
FPMS_MISSION_FRONT_STOP_MM=400

# MEASURED 2026-08-06 (5/5 against operator observation), and REQUIRED.
#
# This constant did not exist in fpms_missions.py at all until recently, while
# a firmware header comment asserted the Pi was compensating with it. A header
# nobody executes and the running code disagreed about a sign, and that
# disagreement is invisible until the rover drives the wrong way.
#
# Every displacement comes from differencing pose, so an inverted sign makes a
# forward burst measure as reverse travel, the residual correction push the
# wrong way, and the retrace replay the error again. Silent and total.
#
#   -1  factory firmware (today)
#   +1  FPMS firmware v3
#
# VERIFY WITHOUT DRIVING, 30 seconds, no battery:
#     python3 ~/fpms_charact.py --push-check
# Push the rover forward along a tape measure. x must INCREASE.
#
# CHANGING THIS INVALIDATES THE SAVED ANCHOR. ~/.fpms_teleop_origin.json records
# "odom was here, the arena was there" under whatever sign was active. Flipping
# it reflects the anchor through the origin and both conventions produce
# perfectly plausible numbers. Re-zero with set_coordinate after changing it.
FPMS_MISSION_ODOM_POSE_SIGN=-1

# DISPUTED and UNMEASURED. The code default in fpms_missions.py is -1; the
# repo's config.env.example ships 1. The two have disagreed for some time. -1
# is derived from the rewiring and was never measured; firmware v3's car_motion
# is REP-103, so v3 wants +1. Left at the code default here so that flashing v3
# is a deliberate, single, documented change rather than an inherited surprise.
FPMS_MISSION_TURN_WIRE_SIGN=-1

# A dead-zone artefact, not a calibration. The factory firmware adds a 50%
# dead zone to every velocity command, making the smallest expressible move
# ~227-230 mm. Firmware v3 has no dead zone and this becomes meaningless -
# replace it with min_moving_duty from a measured calibration profile.
FPMS_MISSION_MIN_PULSE_S=0.35

# ============================================================================
# LiDAR MOUNT TRANSFORM  -  ALL PLACEHOLDERS, NOTHING MEASURED
# ============================================================================
#
# fpms-tf.service passes these to fpms_tf.launch.py. Until 2026-08 that unit
# launched the file with NO ARGUMENTS AT ALL, so the launch file's own
# "MEASURE ME" zeros were what got published and nobody could tell.
#
# By the launch file's own arithmetic, 1 degree of mount yaw is about 10.5 mm
# of position error - and BOTH the obstacle cone guard and the occupancy grid
# inherit that error, in the same direction, so it does not average out.
#
# Metres and RADIANS. If you measured 12 degrees, write 0.2094, not 12.
FPMS_TF_LASER_X=0.0
FPMS_TF_LASER_Y=0.0
FPMS_TF_LASER_Z=0.065
FPMS_TF_LASER_ROLL=0.0
FPMS_TF_LASER_PITCH=0.0
FPMS_TF_LASER_YAW=0.0

FPMS_TF_IMU_X=0.0
FPMS_TF_IMU_Y=0.0
FPMS_TF_IMU_Z=0.0
FPMS_TF_IMU_ROLL=0.0
FPMS_TF_IMU_PITCH=0.0
FPMS_TF_IMU_YAW=0.0

# Set to 1 ONLY after somebody has put a ruler on the robot and written the
# numbers above. fpms-nav2.service and both SLAM units REFUSE TO START while
# this is 0 - navigating on an unmeasured mount transform produces confidently
# wrong positions, which is worse than not navigating.
#
# There is a further prerequisite that no TF value can fix: LIDAR_ROTATION_SIGN
# in fpms_lidar_ros.py is -1 and UNVERIFIED. If the scan is mirrored, no value
# of laser_yaw can undo it - a mirror is not a rigid transform.
FPMS_TF_OFFSETS_MEASURED=0

# ============================================================================
# STOP AUTHORITY  (fpms-cored)
# ============================================================================
#
# fpms-cored has NEVER RUN ON HARDWARE. Its stop path is covered by offline
# assertions but has never touched a broker, a real telemetry/mission stream,
# or systemd. Treat it as ADDITIONAL protection over the executor's own stop,
# never as a replacement, until it has been verified on the rover.
FPMS_CORE_STOP_ESCALATE=1
FPMS_CORE_STOP_ESCALATE_S=3.0
FPMS_CORE_STOP_EVIDENCE_MAX_AGE_S=2.5
FPMS_CORE_ESTOP_ROS=1

# The health list. The repo default omits fpms-teleop, fpms-uros-supervisor and
# fpms-wifi-powersave-hold, so telemetry/health could never show teleop down.
# All eleven are listed here.
FPMS_CORE_UNITS=micro-ros-agent,fpms-rover-agent,fpms-lidar-ros,fpms-odom-tf,fpms-tf,fpms-map-anchor,fpms-missions,fpms-teleop,fpms-cored,fpms-uros-supervisor,fpms-wifi-powersave-hold

# ============================================================================
# BOOT / NETWORK HELPERS  (FPMS-OS additions)
# ============================================================================

# fpms-wait-net: how long an address must hold before a DDS node may start,
# and how long to wait before giving up and starting anyway. See the script.
FPMS_WAITNET_STABLE_S=3
FPMS_WAITNET_TIMEOUT_S=45
FPMS_WAITNET_IFACE=any

# fpms-wifi-ps-hold: how often to re-assert power_save off. The bcmdhd driver
# re-enables it every 30-60s, which flapped MQTT on a measured 47s cycle.
FPMS_WIFI_PS_INTERVAL_S=3

# ============================================================================
# CLOUD UPLINK  -  OFF BY DEFAULT, DELIBERATELY
# ============================================================================
#
# Opting in is a deliberate act: it pushes imagery to a third party, costs
# metered cellular, and spends a Workers free-tier request budget. The rover is
# fully functional with this off. No token is ever baked into the image.
FPMS_CLOUD_UPLINK=0
FPMS_INGEST_URL=
FPMS_INGEST_TOKEN=
FPMS_CLOUD_SPOOL=/var/lib/fpms/uplink-spool.jsonl
