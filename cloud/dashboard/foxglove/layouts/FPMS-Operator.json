    "CallService!plan": {
      "serviceName": "/fpms/plan_m2",
      "requestPayload": "{}",
      "layout": "vertical",
      "editingMode": false,
      "buttonText": "1.  PLAN M2   (preview only)",
      "buttonTooltip": "Sends {\"name\":\"m2\",\"preview\":true}. fpms_missions returns from the preview branch before any of the motion path, so this CANNOT move the rover. The planned route appears on telemetry/mission_plan.",
      "buttonColor": "#1565c0"
    },
    "CallService!arm": {
      "serviceName": "/fpms/arm",
      "requestPayload": "{\n  \"data\": true\n}",
      "layout": "vertical",
      "editingMode": false,
      "buttonText": "2.  ARM   (unlocks RUN for 60 s)",
      "buttonTooltip": "Sends {\"arm\":true}. The rover has its own arm latch (the real interlock, 120 s, auto-clears on any stop or abort). This ALSO opens the bridge's own 60 s window, which is what makes RUN a deliberate second action.",
      "buttonColor": "#ef6c00"
    },
    "CallService!run": {
      "serviceName": "/fpms/run_m2",
      "requestPayload": "{}",
      "layout": "vertical",
      "editingMode": false,
      "buttonText": "3.  RUN M2   (THE ROVER WILL MOVE)",
      "buttonTooltip": "REFUSED unless ARM was pressed within the last 60 s, and one ARM buys exactly one RUN. The rover then applies its own refusals on top: arm latch, odometry link, battery, LiDAR freshness and arena bounds. Read the reply.",
      "buttonColor": "#ad1457"
    },
    "CallService!disarm": {
      "serviceName": "/fpms/arm",
      "requestPayload": "{\n  \"data\": false\n}",
      "layout": "vertical",
      "editingMode": false,
      "buttonText": "DISARM",
      "buttonTooltip": "Sends {\"arm\":false} and clears the bridge's RUN window. Not a stop - it prevents the NEXT mission, it does not halt one already running. Use STOP for that.",
      "buttonColor": "#2e7d32"
    },
    "CallService!resetpose": {
      "serviceName": "/fpms/reset_pose",
      "requestPayload": "{}",
      "layout": "vertical",
      "editingMode": false,
      "buttonText": "RESET POSE  ->  (972, 228) mm",
      "buttonTooltip": "Sends set_coordinate {\"x_mm\":972,\"y_mm\":228} - the arena start pose from arena_zones.json. This DECLARES where the rover is; it does not move it. Physically place the rover on the start square FIRST.",
      "buttonColor": "#00838f"
    },
    "CallService!encoders": {
      "serviceName": "/fpms/read_encoders",
      "requestPayload": "{}",
      "layout": "vertical",
      "editingMode": false,
      "buttonText": "READ ENCODERS",
      "buttonTooltip": "Sends read_encoders. fpms_teleop answers on events/encoders, which is mirrored into /fpms/events - watch the receipts panel on the right.",
      "buttonColor": "#455a64"
    },
