          "colorMode": "flat",
          "flatColor": "#7a7a7aff"
        },
        "/odom": {
          "visible": true
        },
        "/odom_raw": {
          "visible": false
        }
      },
      "layers": {
        "arena-grid": {
          "instanceId": "arena-grid",
          "layerId": "foxglove.Grid",
          "label": "arena 1200 x 1200 mm",
          "visible": true,
          "frameId": "map",
          "frameLocked": true,
          "size": 1.2,
          "divisions": 12,
          "lineWidth": 1,
          "color": "#4a7ab5aa",
          "position": [0.6, 0.6, 0],
          "rotation": [0, 0, 0],
          "order": 1
        }
      },
      "publish": {
        "type": "point",
        "poseTopic": "/move_base_simple/goal",
        "pointTopic": "/clicked_point",
        "poseEstimateTopic": "/initialpose",
        "poseEstimateXDeviation": 0.5,
        "poseEstimateYDeviation": 0.5,
        "poseEstimateThetaDeviation": 0.26179939
      },
      "imageMode": {}
    },
