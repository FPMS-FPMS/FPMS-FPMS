{
  "configById": {
    "Publish!stop": {
      "topicName": "/estop",
      "datatype": "std_msgs/msg/Bool",
      "buttonText": "■  S T O P",
      "buttonTooltip": "PANIC BUTTON. Publishes /estop true. This is a topic publish, not a service call: it cannot be busy, cannot be refused, and needs no reply to have worked. It fans out to the firmware estop latch, the MQTT stop verbs (QoS 1) and fpms-cored's escalation.",
      "buttonColor": "#c62828",
      "advancedView": false,
      "value": "{\n  \"data\": true\n}"
    },
    "Publish!clearstop": {
      "topicName": "/estop",
      "datatype": "std_msgs/msg/Bool",
      "buttonText": "clear e-stop latch",
      "buttonTooltip": "Publishes /estop false. Only firmware v3 latches, so on the current Yahboom stock firmware this does nothing at all. It never un-stops the mission executor: there is deliberately no un-stop MQTT verb.",
      "buttonColor": "#5c5c5c",
      "advancedView": false,
      "value": "{\n  \"data\": false\n}"
    },
    "Indicator!armed": {
      "path": "/fpms/mission/armed.data",
      "style": "background",
      "fallbackColor": "#4a4a4a",
      "fallbackLabel": "ARM STATE UNKNOWN",
      "rules": [
        {
          "rawValue": "true",
          "operator": "=",
          "color": "#c62828",
          "label": "ARMED - IT CAN MOVE"
        },
        {
          "rawValue": "false",
          "operator": "=",
          "color": "#2e7d32",
          "label": "SAFE (disarmed)"
        }
      ]
    },
    "Indicator!linkok": {
      "path": "/fpms/mission/link_ok.data",
      "style": "background",
      "fallbackColor": "#4a4a4a",
      "fallbackLabel": "NO MISSION TELEMETRY",
      "rules": [
        {
          "rawValue": "true",
          "operator": "=",
          "color": "#2e7d32",
          "label": "odometry link OK"
        },
        {
          "rawValue": "false",
          "operator": "=",
          "color": "#ef6c00",
          "label": "ODOMETRY LINK DOWN"
        }
      ]
    },
    "RawMessages!events": {
